# Required: 32 random bytes (base64 or hex). Encrypts stored IMAP/SMTP passwords. Losing it = re-adding accounts.
#   openssl rand -base64 32
MASTER_KEY=

PORT=3000
HOST=127.0.0.1
DB_FILE=./data/mail.db
NODE_ENV=production
# Number of reverse proxies in front (nginx/caddy) so rate limiting sees the real client IP
TRUST_PROXY=1

# Local email+password sign-in. Leave 0 when users come through akun.7mit (SSO).
ALLOW_REGISTRATION=0

# akun.7mit SSO: accept "Authorization: Bearer <JWT>" signed by your identity provider.
# Provide either a JWKS URL (asymmetric keys) or a shared HS256 secret. Token needs `sub` and `email` claims.
SSO_JWKS_URL=
SSO_JWT_SECRET=
SSO_ISSUER=
SSO_AUDIENCE=
SSO_LOGIN_URL=

# Safety switches (keep defaults in production)
ALLOW_PRIVATE_HOSTS=0     # 1 allows IMAP/SMTP hosts on private/loopback addresses (dev/self-hosted only)
ALLOW_INSECURE=0          # 1 allows unencrypted IMAP/SMTP
TLS_REJECT_UNAUTHORIZED=1 # 0 accepts self-signed server certificates
MAX_WATCHERS=200          # max simultaneous IDLE connections
FULL_SYNC_MS=120000       # periodic full folder/unread resync while idling
