# Required: 32 random bytes (base64 or hex). Encrypts stored IMAP/SMTP passwords. Losing it = re-adding accounts.
#   openssl rand -base64 32
MASTER_KEY=

PORT=3000
HOST=127.0.0.1
DB_FILE=./data/mail.db
NODE_ENV=production
# Number of reverse proxies in front (nginx/caddy) so rate limiting sees the real client IP
TRUST_PROXY=1

# Sign-in through akun.7mit (recommended). The backend calls the akun-auth edge function, which checks the
# username/password against portal_login_accounts and issues a session token. When set, local sign-up is disabled.
AKUN_AUTH_URL=https://lajzrempjyoqkubkumhb.supabase.co/functions/v1/akun-auth
# Only needed if the Supabase gateway rejects calls without an `apikey` header (use the publishable key, never the service role key)
AKUN_AUTH_APIKEY=
AKUN_PORTAL_URL=https://akun.7mit.org

# Fallback when AKUN_AUTH_URL is empty: local email+password accounts stored in this app's own database.
ALLOW_REGISTRATION=0

# Safety switches (keep defaults in production)
ALLOW_PRIVATE_HOSTS=0     # 1 allows IMAP/SMTP hosts on private/loopback addresses (dev/self-hosted only)
ALLOW_INSECURE=0          # 1 allows unencrypted IMAP/SMTP
TLS_REJECT_UNAUTHORIZED=1 # 0 accepts self-signed server certificates
MAX_WATCHERS=200          # max simultaneous IDLE connections
FULL_SYNC_MS=120000       # periodic full folder/unread resync while idling
